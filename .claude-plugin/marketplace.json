  "metadata": {
    "description": "Claude Code plugin suite: brewcode for skill/agent/rule authoring and project setups, brewdoc for documentation tools, brewtools for text, ops and subagent-guard utilities, brewui placeholder for UI/visual/creative tools, brewmod-placeholders and brewmod-plan-effort mods (Claude Code 2.1.301+)",
    "version": "6.12.0"
  },
  "plugins": [
