---
interface Props {
  headings?: { depth: number; slug: string; text: string }[];
  variant?: 'rail' | 'inline';
}

const { headings = [], variant = 'rail' } = Astro.props;
const filtered = headings.filter((h) => h.depth === 2);
const mod = Astro.url.pathname.startsWith('/mods/');
---

{filtered.length > 0 && variant === 'rail' && (
  <nav class="sticky top-20 py-8" aria-label="Table of contents">
    <p class="text-xs font-headline uppercase tracking-wider text-base-content/50 mb-3">On this page</p>
    <ul id="toc-list" class="space-y-1 text-sm">
      {filtered.map((heading) => (
        <li>
          <a
            href={`#${heading.slug}`}
            class:list={['toc-link block py-1 transition-colors text-base-content/70', mod ? 'hover:text-mod' : 'hover:text-primary']}
            data-heading={heading.slug}
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

{filtered.length >= 4 && variant === 'inline' && (
  <details class="toc-inline xl:hidden not-prose mb-6 rounded-lg border border-base-300 bg-base-200">
    <summary class="flex min-h-11 cursor-pointer items-center px-4 text-sm font-medium focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary">
      On this page
    </summary>
    <nav class="px-4 pb-3" aria-label="Table of contents (inline)">
      <ul class="text-sm">
        {filtered.map((heading) => (
          <li>
            <a href={`#${heading.slug}`} class="block min-h-10 py-2 text-base-content/80 hover:underline">
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </details>
)}

<script>
  import { onPageInit } from '../../utils/page-init';

  onPageInit(() => {
    const list = document.getElementById('toc-list');
    if (!list || list.dataset.initialized) return;
    list.dataset.initialized = 'true';

    const tocLinks = document.querySelectorAll('#toc-list a[data-heading]');
    if (tocLinks.length === 0) return;

    const tocObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            tocLinks.forEach((link) => {
              link.classList.remove('toc-active');
              link.removeAttribute('aria-current');
            });
            const active = document.querySelector(`#toc-list a[data-heading="${entry.target.id}"]`);
            if (active) {
              active.classList.add('toc-active');
              active.setAttribute('aria-current', 'location');
            }
          }
        });
      },
      { rootMargin: '0px 0px -66% 0px' }
    );

    document
      .querySelectorAll('article h2[id], article details.spoiler[id]')
      .forEach((heading) => {
        tocObserver.observe(heading);
      });
  });
</script>
