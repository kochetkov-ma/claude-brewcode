---
import { GITHUB_URL, getPluginVersion } from '../../utils/github';

const version = getPluginVersion();
---

<footer class="border-t border-base-300 py-8" role="contentinfo">
  <div class="max-w-5xl mx-auto px-4 lg:px-8 text-sm text-base-content/60">
    <div class="flex flex-col sm:flex-row justify-between gap-4">
      <div>
        <p>Brewcode &mdash; Claude Code plugin suite</p>
        <p class="mt-1">&copy; 2026 Brewcode. MIT License</p>
      </div>
      <nav class="flex flex-wrap items-center gap-x-4 gap-y-1" aria-label="Footer links">
        <span class="text-base-content/30 text-xs font-mono">v{version}</span>
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">GitHub</a>
        <a href="https://brewcode.app" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">brewcode.app</a>
        <a href="https://pypi.org/project/brewdoc/" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors" title="Standalone document-to-Markdown tool on PyPI. A separate product, not the brewdoc plugin documented on this site.">brewdoc CLI (separate tool)</a>
      </nav>
    </div>
  </div>
</footer>
