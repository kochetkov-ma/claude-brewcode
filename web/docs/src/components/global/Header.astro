---
import Logo from './Logo.astro';
import Search from '../docs/Search.astro';
import GitHubBadge from './GitHubBadge.astro';
---

<header class="bg-base-200/80 backdrop-blur-md sticky top-0 z-30 border-b border-base-300" role="banner">
  <div class="navbar max-w-[90rem] mx-auto px-4 lg:px-8">
    <div class="flex-1 max-w-5xl flex items-center min-w-0">
      <div class="flex-none lg:hidden">
        <label for="docs-drawer" class="btn btn-square btn-ghost" aria-label="Open menu">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-6 h-6 stroke-current">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </label>
      </div>
      <div class="flex-none hidden lg:block mr-1">
        <button
          id="sidebar-toggle"
          type="button"
          class="btn btn-ghost btn-sm btn-square focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary"
          aria-controls="sidebar-nav"
          aria-expanded="true"
          aria-label="Collapse navigation"
          title="Collapse navigation (B)"
        >
          {/* Lucide panel-left-close / panel-left-open (ISC), swapped by aria-expanded in global.css */}
          <svg data-icon="close" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-5 h-5 stroke-current" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M9 3v18"></path><path d="m16 15-3-3 3-3"></path>
          </svg>
          <svg data-icon="open" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-5 h-5 stroke-current" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M9 3v18"></path><path d="m14 9 3 3-3 3"></path>
          </svg>
        </button>
      </div>
      <div class="flex-1 min-w-0">
        <Logo />
      </div>
    </div>

    <div class="flex-none xl:w-56 xl:pl-8 flex items-center justify-end gap-2">
    <!-- Search button (mobile: icon only) -->
    <button id="search-btn-mobile" class="btn btn-ghost btn-sm btn-square sm:hidden" aria-label="Search">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-5 h-5 stroke-current">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
    </button>

    <!-- Search button (desktop: with text and shortcut) -->
    <button id="search-btn" class="btn btn-ghost btn-sm gap-2 hidden sm:flex" aria-label="Search documentation">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-4 h-4 stroke-current">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <span class="text-xs">Search</span>
      <kbd class="kbd kbd-sm">&#8984;K</kbd>
    </button>

    <Search />

    <a
      href="/mods/overview/"
      class="btn btn-ghost btn-sm hidden sm:flex border border-mod/50 text-mod hover:bg-mod/10 hover:border-mod focus-visible:outline focus-visible:outline-2 focus-visible:outline-mod"
      aria-label="brewcode mods"
    >
      <span class="text-xs">Mods</span>
    </a>

    <a href="/faq/" class="btn btn-ghost btn-sm gap-1 hidden sm:flex" aria-label="FAQ">
      <span class="text-xs">FAQ</span>
    </a>

    <GitHubBadge />
  </div>
  </div>
</header>

<script>
  import { onPageInit } from '../../utils/page-init';

  const KEY = 'sidebar';
  const root = document.documentElement;
  const btn = document.getElementById('sidebar-toggle');

  function sync() {
    if (!btn) return;
    const collapsed = root.dataset.sidebar === 'collapsed';
    btn.setAttribute('aria-expanded', String(!collapsed));
    const label = collapsed ? 'Expand navigation' : 'Collapse navigation';
    btn.setAttribute('aria-label', label);
    btn.setAttribute('title', `${label} (B)`);
  }

  function toggle() {
    const collapsed = root.dataset.sidebar !== 'collapsed';
    if (collapsed) root.dataset.sidebar = 'collapsed';
    else delete root.dataset.sidebar;
    try { collapsed ? localStorage.setItem(KEY, 'collapsed') : localStorage.removeItem(KEY); } catch (e) {}
    sync();
  }

  onPageInit(() => {
    if (!btn) return;
    sync();
    if (btn.dataset.initialized) return;
    btn.dataset.initialized = 'true';
    btn.addEventListener('click', toggle);
    document.addEventListener('keydown', (e) => {
      if (e.key.toLowerCase() !== 'b' || e.metaKey || e.ctrlKey || e.altKey) return;
      const t = e.target as HTMLElement | null;
      if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
      if (!window.matchMedia('(min-width: 1024px)').matches) return;
      toggle();
    });
  });
</script>
