---
import Icon from './Icon.astro';

interface Props {
  title: string;
  icon?: string;
  href?: string;
  variant?: 'default' | 'mod';
  size?: 'lg';
  meta?: string;
}

const { title, icon: rawIcon, href, variant = 'default', size, meta } = Astro.props;
const isMod = variant === 'mod';
const isLg = size === 'lg';
const isExternal = href ? /^https?:\/\//.test(href) : false;
const targetProps = isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {};
// Unknown names warn inside Icon (utils/icons.ts); GitHub URLs on the legacy `link` icon get the GitHub mark.
const icon = rawIcon === 'link' && href && /^https:\/\/github\.com\//.test(href) ? 'github' : rawIcon;
---

<div
  class:list={[
    'not-prose card border p-5 relative',
    isMod ? 'bg-mod/10 border-mod/30' : 'bg-base-200 border-base-300',
    href && (isMod ? 'hover:border-mod hover:shadow-lg hover:shadow-mod/10' : 'hover:border-primary/50 hover:shadow-lg hover:shadow-primary/5') + ' transition-all cursor-pointer',
  ]}
>
  {href && (
    <a href={href} {...targetProps} class="absolute inset-0 z-0 rounded-[inherit]" tabindex="-1" aria-hidden="true"></a>
  )}
  <div class:list={['flex items-start gap-3', href && 'relative z-[1]']}>
    {icon && (
      <span
        class:list={[
          'shrink-0 inline-flex items-center justify-center rounded-lg border',
          isLg ? 'h-12 w-12' : 'h-10 w-10',
          isMod ? 'bg-mod/15 border-mod/30 text-mod' : 'bg-base-300 border-base-300 text-primary',
        ]}
      >
        <Icon name={icon} size={isLg ? 'lg' : 'md'} />
      </span>
    )}
    <div class="min-w-0">
      <h3 class:list={['font-headline font-semibold text-base-content mb-1', isLg && 'text-lg']}>
        {href ? <a href={href} {...targetProps} class="focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 rounded">{title}</a> : title}
      </h3>
      <div class="text-sm text-base-content/70">
        <slot />
      </div>
      {meta && <p class="mt-2 text-xs font-mono text-base-content/60 break-words [overflow-wrap:anywhere]">{meta}</p>}
    </div>
  </div>
</div>
