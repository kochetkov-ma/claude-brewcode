---
interface Props {
  title: string;
  id?: string;
  open?: boolean;
  meta?: string;
}

const { title, id, open = false, meta } = Astro.props;
---

<details class="spoiler not-prose my-3" id={id} open={open}>
  <summary class="spoiler-summary">
    <span class="spoiler-icon" aria-hidden="true">▶</span>
    <span class="spoiler-title">{title}</span>
    {meta && <span class="spoiler-meta">{meta}</span>}
    {id && <a class="spoiler-permalink" href={`#${encodeURIComponent(id)}`} aria-label={`Link to ${title}`}>#</a>}
  </summary>
  <div class="spoiler-content prose">
    <slot />
  </div>
</details>

<script>
  import { onPageInit } from '../../utils/page-init';

  function openSpoilerForHash() {
    const hash = window.location.hash.slice(1);
    if (!hash) return;
    let targetId = hash;
    try {
      targetId = decodeURIComponent(hash);
    } catch {
      // Keep malformed percent escapes usable as literal IDs.
    }
    const target = document.getElementById(targetId);
    if (!target) return;
    let el: Element | null = target.closest('details.spoiler');
    if (!el) return;
    while (el) {
      (el as HTMLDetailsElement).open = true;
      el = el.parentElement?.closest('details.spoiler') ?? null;
    }
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    target.scrollIntoView({ behavior: calm ? 'auto' : 'smooth', block: 'start' });
  }

  function initSpoilerHashHandling() {
    if ((document as any).__spoilerHashInit) return;
    (document as any).__spoilerHashInit = true;
    openSpoilerForHash();
    window.addEventListener('hashchange', openSpoilerForHash);
    document.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement)?.closest('a[href^="#"]') as HTMLAnchorElement | null;
      if (!link) return;
      if (link.classList.contains('spoiler-permalink')) {
        const spoiler = link.closest('details.spoiler') as HTMLDetailsElement | null;
        if (spoiler) spoiler.open = true;
      }
      setTimeout(openSpoilerForHash, 0);
    });
  }

  onPageInit(initSpoilerHashHandling);
</script>

<style>
  .spoiler {
    border: 1px solid #3D3826;
    border-radius: 0.5rem;
    background-color: rgba(235, 187, 64, 0.04);
    overflow: hidden;
  }

  .spoiler[open] {
    background-color: rgba(235, 187, 64, 0.07);
  }

  .spoiler-summary {
    cursor: pointer;
    padding: 0.85rem 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    list-style: none;
    user-select: none;
    font-weight: 600;
    color: #EBBB40;
    transition: background-color 0.15s ease;
  }

  .spoiler-summary::-webkit-details-marker {
    display: none;
  }

  .spoiler-summary:hover {
    background-color: rgba(235, 187, 64, 0.1);
  }

  .spoiler-summary:focus-visible {
    outline: 2px solid #EBBB40;
    outline-offset: -2px;
  }

  .spoiler-icon {
    display: inline-block;
    transition: transform 0.2s ease;
    font-size: 0.75rem;
    color: #EBBB40;
    flex-shrink: 0;
  }

  .spoiler[open] .spoiler-icon {
    transform: rotate(90deg);
  }

  .spoiler-title {
    flex: 1;
    color: #D6D3D1;
  }

  .spoiler-meta {
    margin-left: auto;
    font-size: 0.75rem;
    font-weight: 400;
    color: #A8A29E;
    white-space: nowrap;
  }

  .spoiler-permalink {
    flex-shrink: 0;
    padding: 0.15rem 0.4rem;
    color: #EBBB40;
    text-decoration: none;
    border-radius: 0.2rem;
  }

  .spoiler-permalink:hover {
    text-decoration: underline;
  }

  .spoiler-permalink:focus-visible {
    outline: 2px solid #EBBB40;
    outline-offset: 2px;
  }

  .spoiler .spoiler {
    border-color: rgba(61, 56, 38, 0.7);
    background-color: transparent;
    margin: 0.75rem 0;
  }

  .spoiler .spoiler[open] {
    background-color: transparent;
  }

  .spoiler .spoiler .spoiler-summary {
    padding: 0.6rem 0.9rem;
  }

  .spoiler .spoiler .spoiler-content {
    padding: 0.25rem 0.9rem 0.9rem 0.9rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .spoiler-icon,
    .spoiler-summary {
      transition: none;
    }
  }

  .spoiler-content {
    padding: 0.5rem 1.1rem 1.1rem 1.1rem;
    border-top: 1px solid #3D3826;
    margin-top: 0;
  }

  .spoiler-content > :first-child {
    margin-top: 0.75rem;
  }

  .spoiler-content > :last-child {
    margin-bottom: 0;
  }

  .spoiler-content :global(table) {
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    max-width: 100%;
  }
</style>
