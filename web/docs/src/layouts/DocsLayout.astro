---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import Sidebar from '../components/docs/Sidebar.astro';
import TableOfContents from '../components/docs/TableOfContents.astro';

interface Props {
  title: string;
  description?: string;
  headings?: { depth: number; slug: string; text: string }[];
  currentSlug?: string;
}

const { title, description, headings = [], currentSlug = '' } = Astro.props;

const [first = '', second = ''] = currentSlug.split('/');
const cap = (v: string) => v.charAt(0).toUpperCase() + v.slice(1);
const kind = first === 'mods' ? 'mod' : ['brewcode', 'brewtools', 'brewdoc', 'brewui'].includes(first) ? 'plugin' : 'guide';
const eyebrowLabel = kind === 'mod' ? 'MOD' : kind === 'plugin' ? 'PLUGIN' : 'GUIDE';
const trail = kind === 'mod' ? ['brewcode mods'] : kind === 'plugin' ? [first, ...(['skills', 'agents'].includes(second) ? [cap(second)] : [])] : [];
---

<BaseLayout title={title} description={description}>
  <script is:inline src="/sidebar-init.js"></script>
  <div class="drawer lg:drawer-open">
    <input id="docs-drawer" type="checkbox" class="drawer-toggle" />

    <!-- Main content area (Header + content + footer) -->
    <div class="drawer-content flex flex-col min-h-screen">
      <Header />

      <main id="main-content" class="flex-1 flex justify-center" role="main">
        <div class="flex w-full max-w-[90rem] px-4 lg:px-8">
          <!-- Article content -->
          <article class="prose flex-1 max-w-5xl py-8 min-w-0" data-kind={kind} data-pagefind-body>
            {/* Pagefind: title x30 at weight 10 (sr-only), body at 0.2 so the title dominates; no data-pagefind-meta=title (it would overwrite the h1 title) */}
            <span class="sr-only" aria-hidden="true">
              <span data-pagefind-weight="10">{Array(30).fill(title).join(' ')}</span>
            </span>
            <p class="eyebrow not-prose" data-pagefind-ignore>
              <span class="eyebrow-chip">{eyebrowLabel}</span>
              {trail.length > 0 && <span>{trail.join(' / ')}</span>}
            </p>
            <div data-pagefind-ignore>
              <TableOfContents headings={headings} variant="inline" />
            </div>
            <div data-pagefind-weight="0.2" style="display: contents">
              <slot />
            </div>
          </article>

          <!-- TOC (right side, visible xl+) -->
          <aside class="hidden xl:block w-56 shrink-0 pl-8" aria-label="Table of contents">
            <TableOfContents headings={headings} />
          </aside>
        </div>
      </main>

      <Footer />
    </div>

    <!-- Sidebar drawer -->
    <div class="drawer-side z-40">
      <label for="docs-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
      <div class="w-72 min-h-full bg-base-200 p-4 pt-20 lg:pt-4">
        <Sidebar currentSlug={currentSlug} />
      </div>
    </div>
  </div>
</BaseLayout>
