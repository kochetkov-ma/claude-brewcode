{
  "mcpServers": {
    "semble_code": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "semble[mcp]", "semble", "--content", "code", "config"],
      "env": { "SEMBLE_CACHE_LOCATION": "~/Library/Caches/semble" }
    }
  },
  "projects": {
    "__PROJECT_ROOT__": {
      "mcpServers": {}
    }
  }
}
