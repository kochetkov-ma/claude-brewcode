{
  "permissions": {
    "allow": ["Bash(git status:*)", "Read(//tmp/**)", "mcp__other__search"],
    "deny": ["Bash(rm -rf /:*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node", "args": ["/opt/foreign/pre-bash.mjs"], "timeout": 5 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node", "args": ["/opt/foreign/subagent-stop.mjs"], "timeout": 10 }
        ]
      }
    ]
  }
}
